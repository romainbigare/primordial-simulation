--- a/tape/tests/tape.rs
+++ b/tape/tests/tape.rs
@@ -288,3 +288,40 @@ fn null_run_freezes_the_brain_rows() {
     assert!(real.0 > 0 && real.1 > 0, "the real run learns and mutates rows: {real:?}");
