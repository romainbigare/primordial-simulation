@@ -443,6 +443,8 @@ pub fn grow(w: &mut World, b: &mut Body, days: f64) -> bool {
     b.e -= dh * ext;
     // What it made: up to what its maturity lacks it is body, of the rest the share `ALLOC` is brood.
     let made = nu0 * ext * mm;
+    let pr = w.life.root(b);
