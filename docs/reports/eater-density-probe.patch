     pub nlim: Vec<Vec<f64>>,
+    /// PROBE (not to merge): by root, [light J stored, upkeep J paid, built kg x days, matter kg made, mass kg x days, fuel kg given to children]
+    #[serde(skip)]
+    pub probe: Vec<[f64; 6]>,
+}
+
+impl Diag {
+    pub fn add_probe(&mut self, root: u32, i: usize, v: f64) {
+        if root == u32::MAX { return; }
+        let r = root as usize;
+        if self.probe.len() <= r { self.probe.resize(r + 1, [0.0; 6]); }
+        self.probe[r][i] += v;
+    }
 }
 
