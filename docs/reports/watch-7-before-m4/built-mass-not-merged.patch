+/// What a body may still pay into building today, J: `c_build` x its `equiv` / `m_ref` x the days
+/// since it last paid, at most its interval (building takes time, 14 Oct 2026, review 5; once per
+/// day however often a body builds in one update, review 6, finding 6). Growth (`grow`) and the
+/// children (`copy`) share it: on the day it paid, what is left of it (`Body::build_left`).
+pub fn allowance(w: &World, b: &Body, mass: f64) -> f64 {
+    let (p, days) = (&w.cfg.phys, b.interval() as f64);
+    match b.paid_day {
+        Some(d) if d == w.day => b.build_left.max(0.0),
+        d => p.c_build * b.equiv(p, mass) / p.m_ref * days.min(d.map_or(days, |d| w.day.saturating_sub(d) as f64)),
+    }
+}
+
+/// `x` J of the allowance `room` were paid today (the rest is left for the other builder).
+fn spend(w: &World, b: &mut Body, x: f64, room: f64) {
+    (b.paid_day, b.build_left) = (Some(w.day), (room - x).max(0.0));
+}
+
+/// Growth is building (14 Oct 2026, review 6, finding 5): a member whose dry mass is above what it
+/// has built builds the difference as far as it can, `c_copy` per kg like the children (the
+/// matter is already in its stores; the work is what makes it body), from the same allowance
+/// (`allowance`, `c_build`), first, before its children. The work burns fuel, so the dry mass
+/// that becomes body is what is above `built` less what the work burns (`Body::burnt_per_j`): a
+/// kg built costs `c_copy` of fuel energy and the fuel's mass too. It builds only what it can
+/// spare: after paying, its reactions must still release its upkeep over an interval (as a body
+/// copying before `full`, `copy`), and nothing when they cannot. What it does not build stays
+/// stores (fuel it may burn), not body. A body below `built` is a body emptied by burning:
+/// refilling it costs nothing. Returns whether it built.
+pub fn grow(w: &mut World, b: &mut Body) -> bool {
+    let (chem, c_copy) = (&w.chem, w.cfg.phys.c_copy);
+    let (mass, n) = (b.mass(chem), b.n());
+    let above = b.dry(chem) - b.built * n;
+    if above <= 1e-12 * mass {
+        return false;
+    }
+    let (days, t) = (b.interval() as f64, b.temp(chem));
+    // Burning x J of fuel takes `burnt` kg x x out of the dry mass, so what is built, d kg for
+    // `c_copy` d J, leaves (1 + c_copy burnt) d kg of the dry mass above `built`.
+    let burnt = b.burnt_per_j(chem, t);
+    let room = allowance(w, b, mass);
+    let r = 0.999 * body::release(w, b, days);
+    let spare = b.fuel(chem, t) * (1.0 - body::upkeep(w, b, days, mass) / r.max(1e-300));
+    let x = (c_copy * above / (1.0 + c_copy * burnt)).min(room).min(spare).min(r);
+    if x <= 0.0 || !body::pay(w, b, x, days) {
+        return false;
+    }
+    spend(w, b, x, room);
+    // (Clamped to the dry mass left: the work burns what is above `built`, never the body.)
+    b.built += (x / c_copy).min((b.dry(&w.chem) / n - b.built).max(0.0) * n) / n;
+    true
+}
