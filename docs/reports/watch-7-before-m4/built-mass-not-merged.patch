diff --git a/core/tests/build.rs b/core/tests/build.rs
new file mode 100644
index 0000000..b1f973b
--- /dev/null
+++ b/core/tests/build.rs
@@ -0,0 +1,269 @@
+//! A body is built, not just filled (14 Oct 2026, review 6, findings 5 and 12): size is the dry
+//! mass a body has paid to build (`Body::built`, kg per member). Growth is building (`copy::grow`,
+//! `c_copy` per kg from the `c_build` allowance, before the children), a child is given built mass
+//! its parent paid for, a body emptied by burning refills for nothing, a body copies when its
+//! built mass is full, and satiety holds at every size.
+
+use pcore::body::{Body, COPY_MASS, DISPERSE, STRENGTH};
+use pcore::rng::{Purpose, Rng};
+use pcore::{body, brain, change, choose, copy, flow, World};
+
+/// A land cell with dry ground.
+fn dry_land(w: &World) -> usize {
+    (0..w.grid.n()).find(|&i| w.life.env[i][2] > 0.0 && w.life.env[i][1] < 1e-3).expect("dry land")
+}
+
+/// A starting eater (30 kg, 9 kg of it built dry mass) of a brain that only does fixed action `act`
+/// (0 rests, 3 takes from the ground), weak (strength 0), staying where it is, copying at 10^6 kg.
+fn eater(w: &mut World, i: usize, act: usize) -> Body {
+    let shape = choose::shape(w.chem.ns(), 12, 6);
+    let mut fixed = [-8.0; brain::FIXED];
+    fixed[act] = 8.0;
+    let mut base = brain::random(shape, &mut Rng::new(1, 0, 0, Purpose::Body), 0.1, fixed, -8.0, [-8.0; brain::VERBS + brain::OVERBS]);
+    let rows = base.split_off(shape.base());
+    let (l, g) = (w.life.new_lineage(body::Lineage { shape, seen: 3, sight: 1, base, root: 0 }), w.life.new_genome(rows));
+    let mut b = worldgen::life::make(w, 1, i, l, g).expect("body");
+    (b.genes[DISPERSE], b.genes[STRENGTH], b.genes[COPY_MASS]) = (0.0, 0.0, 6.0);
+    b
+}
+
+/// A body `f` times the size (stores and heat; booked as an edit), still built.
+fn scale(w: &mut World, b: &mut Body, f: f64) {
+    for k in 0..w.chem.ns() {
+        w.chem.add_elems(k, (f - 1.0) * b.store[k], &mut w.ledger.imposed_elems);
+        w.ledger.imposed_energy += (f - 1.0) * b.store[k] * w.chem.subs[k].hf;
+        b.store[k] *= f;
+    }
+    w.ledger.imposed_energy += (f - 1.0) * b.e;
+    b.e *= f;
+    b.built = b.dry(&w.chem) / b.n();
+}
+
+/// `kg` of substance `k` added to a body at its temperature (booked as an edit), or taken out if
+/// negative. Its built mass is as it was.
+fn add(w: &mut World, b: &mut Body, k: usize, kg: f64) {
+    let (a, t) = (kg / w.chem.subs[k].molar_mass, b.temp(&w.chem));
+    w.chem.add_elems(k, a, &mut w.ledger.imposed_elems);
+    w.ledger.imposed_energy += a * (w.chem.subs[k].hf + w.chem.subs[k].cp * t);
+    b.store[k] += a;
+    b.e += a * w.chem.subs[k].cp * t;
+}
+
+/// One day: the flow and change steps when due, then the bodies due.
+fn day(w: &mut World) {
+    let dt = w.cfg.phys_days as f64 * 86_400.0;
+    if (w.day % w.cfg.days_per_month as u64).is_multiple_of(w.cfg.phys_days as u64) {
+        body::survey(w);
+        flow::step(w, dt);
+        change::step(w, dt);
+    }
+    w.events.clear();
+    body::day(w);
+    w.day += 1;
+}
+
+fn start() -> (World, usize, usize, usize) {
+    let mut w = worldgen::new_world(1, 16, 16);
+    pcore::step(&mut w);
+    let i = dry_land(&w);
+    let (_, rich, liquid, _) = worldgen::life::roles(&w.chem).expect("roles");
+    (w, i, rich, liquid)
+}
+
+/// Growth is building: a child of 13 kg (3.9 kg of it built) holding 5 kg of dry mass more than it
+/// has built turns it into body at most `c_build` x `equiv` / `m_ref` x the days of its interval
+/// over `c_copy` kg of dry body a day (a quarter of the allowance of a grown one, not free), and
+/// at that rate while it has the dry mass to build, from its fuel, so its built mass never passes
+/// its dry mass. Matter and energy are kept exactly over the updates.
+#[test]
+fn a_child_builds_its_body_at_most_c_build_times_equiv_over_c_copy_a_day() {
+    let (mut w, i, rich, _) = start();
+    let mut b = eater(&mut w, i, 0);
+    scale(&mut w, &mut b, 13.0 / 30.0);
+    add(&mut w, &mut b, rich, 5.0);
+    let (built0, p) = (b.built, w.cfg.phys);
+    let s = w.life.add(b, w.day, 1);
+    let (t0, l0) = (pcore::check::totals(&w), w.ledger.clone());
+    let (mut log, mut last, mut total) = (Vec::new(), (built0, w.day), 0.0);
+    for _ in 0..60 {
+        day(&mut w);
+        let b = &mut w.life.bodies[s];
+        assert!(b.alive, "the child died");
+        if b.last == w.day - 1 && w.day - 1 > last.1 {
+            b.prepare(&w.chem, &p);
+            // (A body that has not paid yet has the allowance of its whole interval.)
+            let since = if log.is_empty() { b.interval() } else { (w.day - 1 - last.1).min(b.interval()) };
+            let cap = p.c_build * b.equiv(&p, b.mass(&w.chem)) / p.m_ref * since as f64 / p.c_copy;
+            let grew = b.built - last.0;
+            log.push((grew, cap));
+            assert!(grew <= cap * 1.05, "built {grew:e} kg in an update, the allowance is {cap:e} kg");
+            assert!(b.built <= b.dry(&w.chem) * (1.0 + 1e-9), "built {} kg of {} kg of dry mass", b.built, b.dry(&w.chem));
+            total += grew;
+            last = (b.built, w.day - 1);
+        }
+    }
+    println!("built per update, kg, with the allowance: {log:?}");
+    let days = (last.1 - 1) as f64;
+    let first = p.c_build * w.life.bodies[s].equiv(&p, 13.0) / p.m_ref * days / p.c_copy;
+    assert!(log.len() >= 5 && log.iter().filter(|x| x.0 > 0.8 * x.1).count() >= log.len() * 3 / 4, "the allowance does not bind: {log:?}");
+    assert!(total > 0.0 && total <= 2.0 * first, "built {total} kg in {days} days, the allowance of 13 kg is {first} kg");
+    // Years, not days: the 14 kg of dry body between a child of 13 kg and an adult of 60 kg (30% dry) takes years at this rate.
+    let years = 14.0 / (total / days * 365.0);
+    assert!(years > 1.0, "{years} years to build 14 kg of dry body");
+    assert_eq!(pcore::check::broken(&w), None);
+    let (de, dq) = pcore::check::drift(&w, &t0, &l0);
+    assert!(de < 1e-9 && dq < 1e-9, "element drift {de:e}, energy drift {dq:e}");
+}
+
+/// A body emptied by burning refills for nothing: an eater at half the dry mass it has built, on
+/// ground with the energy-rich solid, takes it back to the body it has built without paying any
+/// building (`Body::paid_day` stays unset and its built mass unchanged while its dry mass is below
+/// it), and a starved body is not a smaller one. Matter and energy are kept exactly.
+#[test]
+fn a_starved_body_refills_to_its_built_mass_at_no_build_cost() {
+    let (mut w, i, rich, _) = start();
+    // A kg of the energy-rich solid per m² on its ground (booked as an edit).
+    let (t, a) = (w.t_ground(i), w.grid.area() / w.chem.subs[rich].molar_mass);
+    let n = w.grid.n();
+    w.ground[rich * n + i] += a;
+    w.chem.add_elems(rich, a, &mut w.ledger.imposed_elems);
+    let e = w.energy_ground(i, t);
+    (w.ledger.imposed_energy, w.e_ground[i]) = (w.ledger.imposed_energy + e - w.e_ground[i] + a * w.chem.subs[rich].hf, e);
+    let mut b = eater(&mut w, i, 3);
+    let built = b.built;
+    let half = 0.5 * b.dry(&w.chem);
+    add(&mut w, &mut b, rich, -half);
+    assert!(b.dry(&w.chem) < 0.55 * built && b.built == built);
+    let s = w.life.add(b, w.day, 1);
+    let (t0, l0) = (pcore::check::totals(&w), w.ledger.clone());
+    let mut refilled = 0;
+    for _ in 0..200 {
+        let b = &w.life.bodies[s];
+        let below = b.alive && b.dry(&w.chem) < 0.97 * b.built;
+        let (before, paid) = (b.built, b.paid_day);
+        day(&mut w);
+        let b = &w.life.bodies[s];
+        assert!(b.alive, "the body starved");
+        if below {
+            // (An update that starts below the body it has built builds nothing.)
+            assert!(b.built == before && b.paid_day == paid, "built {} kg from {before} kg, paid on {:?}", b.built, b.paid_day);
+        }
+        refilled += (b.dry(&w.chem) >= 0.97 * b.built) as u32;
+        if refilled >= 3 {
+            break;
+        }
+    }
+    let b = &w.life.bodies[s];
+    println!("built {} kg of {built} kg, dry {} kg, paid on {:?}", b.built, b.dry(&w.chem), b.paid_day);
+    assert!(refilled >= 3, "it never refilled: dry {} of {} kg", b.dry(&w.chem), b.built);
+    assert!(b.built == built && b.paid_day.is_none(), "refilling cost building: built {} kg of {built}, paid on {:?}", b.built, b.paid_day);
+    assert_eq!(pcore::check::broken(&w), None);
+    let (de, dq) = pcore::check::drift(&w, &t0, &l0);
+    assert!(de < 1e-9 && dq < 1e-9, "element drift {de:e}, energy drift {dq:e}");
+}
+
+/// Satiety holds at every size and for a growing body (14 Oct 2026, review 6, finding 5): asked for
+/// twice what its size can take, a body that holds more dry mass than it has built (a child with
+/// stores to build) of 0.1, 1, 10 or 100 times a starting eater's mass is left with its upkeep's
+/// worth of fuel, or the dry mass it can build in the interval if that is more, and never the
+/// size cap. Before, a body below `full` times its copy mass was left everything its size allowed.
+#[test]
+fn satiety_caps_a_growing_body_at_every_size() {
+    let (mut w, i, rich, _) = start();
+    let (_, _, _, burn) = worldgen::life::roles(&w.chem).expect("roles");
+    let joule_per_kg = -w.chem.dh(burn) / w.chem.reactions[burn].inputs.iter().find(|x| x.0 as usize == rich).unwrap().1 as f64 / w.chem.subs[rich].molar_mass;
+    for times in [0.1, 1.0, 10.0, 100.0] {
+        let mut b = eater(&mut w, i, 0);
+        scale(&mut w, &mut b, times);
+        // A third more dry mass than it has built.
+        let extra = b.dry(&w.chem) / 3.0;
+        add(&mut w, &mut b, rich, extra);
+        assert!(b.dry(&w.chem) > 1.3 * b.built * b.n());
+        b.prepare(&w.chem, &w.cfg.phys);
+        let (p, days, mass) = (w.cfg.phys, b.interval() as f64, b.mass(&w.chem));
+        let (equiv, up) = (b.equiv(&p, mass), body::upkeep(&w, &b, days, mass));
+        let (cap, grow) = (p.take * days * equiv, p.c_build * equiv / p.m_ref * days / p.c_copy);
+        let mut m = vec![0.0; w.chem.ns()];
+        m[rich] = 2.0 * cap / w.chem.subs[rich].molar_mass;
+        choose::sate(&w, &b, &mut m, days, mass);
+        let left = m[rich] * w.chem.subs[rich].molar_mass;
+        let want = (up / joule_per_kg).max(grow);
+        println!("{times} x 30 kg: left {left:.3} kg of {:.3} asked; upkeep {:.3} kg, build {grow:.3} kg, size cap {cap:.3} kg", 2.0 * cap, up / joule_per_kg);
+        assert!(left < cap && (left / want - 1.0).abs() < 1e-6, "left {left} kg, the upkeep's worth or the build is {want} kg, the size cap {cap} kg");
+    }
+}
+
+/// A body copies when its built dry mass is full, not its whole mass (14 Oct 2026): an eater of
+/// 300 kg, mostly liquid, that has built less than its copy mass does not copy and pays nothing
+/// toward a child however much it holds; one that has built its copy mass does, though it weighs
+/// 30 kg. A child is given the dry mass its parent paid `c_copy` for as the body it has built, and
+/// its parent's built mass falls by the share it gave away: an individual that gives the share `s`
+/// of its stores keeps (1 - s) of its built mass. Matter and energy are kept exactly.
+#[test]
+fn a_body_copies_when_its_built_mass_is_full_and_gives_its_children_built_mass() {
+    let (mut w, i, _, liquid) = start();
+    // 270 kg more liquid on a body of 9 kg built: 300 kg in all, copy mass 10 kg of built dry mass.
+    let mut heavy = eater(&mut w, i, 0);
+    add(&mut w, &mut heavy, liquid, 270.0);
+    heavy.genes[COPY_MASS] = 10f32.log10();
+    heavy.prepare(&w.chem, &w.cfg.phys);
+    assert!(heavy.mass(&w.chem) > 10.0 * 10.0 && heavy.built < 10.0);
+    let hs = w.life.add(heavy, w.day, 1);
+    let mut heavy = std::mem::take(&mut w.life.bodies[hs]);
+    w.day += 1;
+    let (paid, day0) = (heavy.paid, heavy.paid_day);
+    assert!(!copy::copy(&mut w, hs, &mut heavy) && heavy.paid == paid && heavy.paid_day == day0, "copied with {} kg built of 10 kg", heavy.built);
+    w.life.bodies[hs] = heavy;
+    // A body of 30 kg that has built 9 kg of dry mass, copy mass 8 kg: it pays toward a child, and
+    // with a copy cost small enough to pay in one interval it has the child at once.
+    let mut b = eater(&mut w, i, 0);
