+/// Built mass goes where stores go: it is the mean over a node's members, pooled by count when
+/// bodies join (`copy::take_in`, `merge`), kept by a split (`part`) and given, per member, to the
+/// members drawn from a node (`copy::open`).
+#[test]
+fn built_mass_is_pooled_by_count_and_kept_by_splits() {
+    let (mut w, i, rich, _) = start();
+    let _ = rich;
+    let mut a = eater(&mut w, i, 0);
+    a.count = 3.0;
+    a.store.iter_mut().for_each(|x| *x *= 3.0);
+    a.e *= 3.0;
+    let mut c = a.clone();
+    (c.count, c.built) = (1.0, 6.0);
+    c.store.iter_mut().for_each(|x| *x /= 3.0);
+    c.e /= 3.0;
+    a.built = 10.0;
+    let (sa, sc) = (w.life.add(a, w.day, 1), w.life.add(c, w.day, 1));
+    copy::merge(&mut w, sc, sa);
+    let n = &w.life.bodies[sa];
+    assert!((n.built - (3.0 * 10.0 + 6.0) / 4.0).abs() < 1e-9, "pooled {} kg, the mean is 9 kg", n.built);
+    let drawn = copy::open(&mut w, sa, 2);
+    assert_eq!(drawn.len(), 2);
+    for d in drawn {
+        assert!((w.life.bodies[d].built - 9.0).abs() < 1e-9, "a member drawn has {} kg built", w.life.bodies[d].built);
+    }
+    assert!((w.life.bodies[sa].built - 9.0).abs() < 1e-9, "the node has {} kg built", w.life.bodies[sa].built);
+}
